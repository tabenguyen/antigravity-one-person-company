# Copy to .env (gitignored) and `chmod 600 .env`. `hq` loads it at start;
# a variable already set in the shell wins over the file. Never commit .env.

# Facebook Page token (Page or System User token) and the Meta app secret
AGYHQ_FB_PAGE_TOKEN=
AGYHQ_FB_APP_SECRET=

# Mailbox passwords (optional; the Setup page can store them encrypted instead)
# AGYHQ_IMAP_PASS=
# AGYHQ_SMTP_PASS=
