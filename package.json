{
  "name": "antigravity-one-person-company",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.json",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "hq": "tsx packages/cli/src/main.ts",
    "release:notes": "node scripts/release-notes.mjs",
    "demo:screenshots": "tsx scripts/demo/screenshots.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
