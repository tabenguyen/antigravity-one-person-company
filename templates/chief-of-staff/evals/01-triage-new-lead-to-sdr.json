{
  "id": "triage-new-lead-to-sdr",
  "description": "An unknown retailer writes asking about the product. Expected: delegated to the SDR (research or reply kind) using only roster ids/kinds, exactly one task_create.",
  "kind": "cos.triage",
  "contact": {
    "email": "lan.nguyen@vietshop-eval.example",
    "name": "Lan Nguyen",
    "language": "en",
    "source": "inbound-email",
    "companyName": "VietShop Online",
    "companyDomain": "vietshop-eval.example"
  },
  "input": {
    "inboundEventId": "evt-eval-001",
    "fromAddress": "lan.nguyen@vietshop-eval.example",
    "fromName": "Lan Nguyen",
    "subject": "Does StockSync work with Shopee and Lazada?",
    "body": "Hi, I run operations for VietShop Online (about 35 staff). We sell on Shopee and Lazada and keep overselling when stock runs low. Does StockSync cover both, and could someone walk us through it this week?",
    "classification": "new_lead",
    "roster": [
      {
        "agentId": "eval-sdr",
        "role": "sales-sdr",
        "displayName": "Mai",
        "kinds": [
          "sdr.research_lead",
          "sdr.first_touch",
          "sdr.follow_up",
          "sdr.handle_reply",
          "sdr.pipeline_review"
        ]
      },
      {
        "agentId": "eval-am",
        "role": "account-manager",
        "displayName": "Linh",
        "kinds": [
          "am.onboard",
          "am.handle_message",
          "am.check_in",
          "am.account_review"
        ]
      }
    ]
  },
  "assertions": [
    {
      "type": "result.status",
      "equals": "done"
    },
    {
      "type": "result.data.path",
      "path": "decision.action",
      "equals": "delegated"
    },
    {
      "type": "result.data.path",
      "path": "decision.assigneeAgentId",
      "equals": "eval-sdr"
    },
    {
      "type": "result.data.path",
      "path": "decision.kind",
      "oneOf": [
        "sdr.research_lead",
        "sdr.handle_reply"
      ]
    },
    {
      "type": "result.data.path",
      "path": "decision.reason",
      "exists": true
    },
    {
      "type": "tool.called",
      "tool": "task_create"
    },
    {
      "type": "tool.called",
      "tool": "crm_find_contact"
    },
    {
      "type": "tool.notCalled",
      "tool": "outbox_draft_email"
    }
  ]
}
